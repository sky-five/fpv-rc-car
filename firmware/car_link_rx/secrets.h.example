#pragma once
// Copy this file to secrets.h (same folder) and fill in your networks.
// secrets.h is gitignored — never commit real credentials.
//
// !! The car can only be flashed over WiFi. If you change these, make sure the car
// can still reach at least one of the networks, or it can't be updated again.
// (Firmware 2.x rolls back automatically if a new image can't get onto WiFi.)

// Networks are tried in priority order: 1 first, then 2 as fallback.
#define WIFI_SSID_1 "your-rc-network"
#define WIFI_PASS_1 "your-rc-network-password"
#define WIFI_SSID_2 "your-home-network"
#define WIFI_PASS_2 "your-home-network-password"

// Optional: require a password for OTA uploads. tools/flash.py reads this line and
// passes it to espota automatically. The firmware on the car today accepts uploads
// without a password; adding one takes effect from the next flash onwards.
// #define OTA_PASSWORD "choose-a-password"
